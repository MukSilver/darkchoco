# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 절대 공유·커밋하지 마세요)

# 1) https://www.notion.so/my-integrations 에서 Internal integration 생성 → Internal Integration Secret 복사
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) 노션에서 해당 DB 페이지 열기 → 우측 상단 ⋯ → 연결(Connections) → 위에서 만든 integration 추가
#    (이걸 안 하면 API 가 "object_not_found" 를 돌려줍니다)

# 3) DB URL 에서 32자리 ID 복사
#    https://www.notion.so/<workspace>/<32자리 DATABASE_ID>?v=<view id>
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
