{
  "name": "dls-observatory",
  "owner": "안유빈",
  "github": "@60secAgo",
  "summary": "유출 사이트가 살아 있는지 보고 노션 명부를 갱신합니다",
  "runs_in": "host",
  "commands": {
    "diagnose": "python diagnose.py",
    "fill": "python dls_fill.py",
    "fill-apply": "python dls_fill.py --apply",
    "db": "python dls_db.py",
    "tor": "python tor_probe.py"
  },
  "default": "diagnose",
  "run_cwd": ".",
  "install": {
    "requirements": null,
    "note": "표준 라이브러리만 씁니다. 받을 것이 없습니다"
  },
  "preconditions": {
    "docker": false,
    "tor": "tor_probe 만",
    "interactive_login": false
  },
  "secrets": [
    {
      "key": "NOTION_TOKEN",
      "where": "노션 integration 을 만들어 받습니다"
    },
    {
      "key": "NOTION_DATABASE_ID",
      "where": "대상 DB 주소에서 32자리를 떼어 씁니다"
    }
  ],
  "config_files": [
    {
      "path": ".env",
      "example": ".env.example"
    }
  ],
  "packages": [
    "dc_console",
    "dc_notion",
    "dc_ransomfeed"
  ],
  "output": "dls.sqlite3 · 노션",
  "docs": "README.md",
  "note": "--apply 를 안 붙이면 미리보기입니다. 기본이 미리보기입니다"
}
