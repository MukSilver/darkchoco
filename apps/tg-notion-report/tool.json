{
  "name": "tg-notion-report",
  "owner": "이수빈",
  "github": "@leesubhin060-max",
  "summary": "텔레그램 채널을 모아 노션 보고서로 반영합니다",
  "runs_in": "host",
  "commands": {
    "pipeline": "python telegram_pipeline.py <url>",
    "collect": "python collect_messages.py <url>",
    "login": "python test.py"
  },
  "default": "pipeline",
  "run_cwd": ".",
  "install": {
    "requirements": "requirements.txt"
  },
  "preconditions": {
    "docker": false,
    "tor": false,
    "interactive_login": "텔레그램"
  },
  "secrets": [
    {
      "key": "TELEGRAM_API_ID",
      "where": "my.telegram.org"
    },
    {
      "key": "TELEGRAM_API_HASH",
      "where": "my.telegram.org"
    },
    {
      "key": "NOTION_TOKEN",
      "where": "노션 integration"
    }
  ],
  "config_files": [],
  "packages": [
    "dc_notion",
    "dc_telegram"
  ],
  "output": "output/ · 노션",
  "docs": "README.md",
  "note": "노션에 쓰기 전 안전 판정을 거칩니다. 후보가 0개거나 2개 이상이면 멈춥니다"
}
