# 인증 정보 — SR-10. 저장소에 절대 넣지 않는다
.env
.env.*
!.env.example
*.key
*.pem

# 자료 — 노션에서 다시 만들 수 있다. 저장소에 담지 않는다
data/standard/*.json
data/bm25_index/*
data/images/*
data/export/*
