data/excluded_rows.json
data/batch_log.jsonl
data/sync_state.json
data/source_version.txt
data/ragdb.sqlite
data/ragdb.sqlite-wal
data/ragdb.sqlite-shm
!data/**/.gitkeep

# 백업 — DR-08. 운영 PC 밖으로 나갈 때는 암호를 건다(SR-17)
backup/
*.backup

# 파이썬
__pycache__/
*.py[cod]
