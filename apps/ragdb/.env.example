# 이 파일을 .env로 복사해 값을 채웁니다. .env는 저장소에 올라가지 않습니다 (SR-10).
# 키를 지시문이나 코드에 직접 적지 않습니다 (SR-11).
#
# 「첫 값」 이라고 적은 것은 명세서의 미결(OI)을 닫은 값이 아닙니다. 문제집으로 재기 전에 돌려 보려고 둔
# 출발점입니다. 재고 나면 여기 숫자만 바꿉니다. 비워 두면 app/config.py 의 기본값을 씁니다.

# ── 입력: Supabase rag 스키마 (F-01). 노션 토큰은 두지 않습니다 (판 1.6) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Claude: 답변 생성 (F-13) 과 조직 이름 찾기 (scripts/find_names.py) ──
# 전용 워크스페이스에서 발급하고, 콘솔에서 월 지출 한도를 걸고 자동 충전을 끕니다
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5
# 생각하기는 끕니다 (F-13 처리 4). 모델을 바꿔 disabled 가 거절되면 between_tools 나 omit 으로 바꿉니다
ANSWER_THINKING=disabled
ANSWER_MAX_TOKENS=1024
QUESTION_MAX_CHARS=300

# ── 재순위 (F-12 처리 8). 열쇠가 비어 있으면 낱말 점수 순서로 답합니다 ──
COHERE_API_KEY=
RERANK_ENABLED=1
RERANK_MODEL=rerank-v3.5
RERANK_TIMEOUT_MS=5000
RERANK_MIN_SCORE=0

# ── 검색 (F-12) ──
CANDIDATE_M=50
FINAL_K=5
# 첫 값. 예비 측정(2026-09-30)에서 별칭 질문이 다 드는 가장 작은 값. 0 이면 넓히기가 꺼집니다
EXPANSION_WEIGHT=0.3
EXPANSION_MAX_ITEMS=5
EXPANSION_MAX_FORMS=5
KIND_BOOST=0.1
OFFLINE_FACTOR=0.85
MIN_BODY_CHARS=40

# ── 사용량 (F-18) ──
# 하루 전체 비용 한도. 넘으면 새 답변만 쉽니다
DAILY_BUDGET_USD=3
# 사람별 제한. 0 이면 쓰지 않습니다 (2026-09-30 결정: 사람별 제한 없이 하루 차단기만)
RATE_CONCURRENT=0
RATE_PER_MINUTE=0
RATE_PER_HOUR=0

# ── 기록 (F-19, F-20) ──
# 지문 키. 아무도 모르는 긴 글자열을 넣습니다. 바꾸면 그 전 지문은 대조 못함이 됩니다
#   python -c "import secrets; print(secrets.token_hex(32))"
FINGERPRINT_KEY=
WORD_FP_MIN_CHARS=2
WORD_FP_TTL_DAYS=14
# 확인일이 이보다 오래되면 「오래됨」 (OI-29 첫 값)
STALE_DAYS=90

# ── 조직 이름 찾기 ──
# 한 번 돌릴 때 쓰는 돈의 상한(달러). 처음 전체를 볼 때 4달러쯤 들고, 그 뒤로는 바뀐 문서만 봅니다
NAME_FIND_BUDGET_USD=8
# 이름 찾기를 거치지 않은 문서는 내보내지 않습니다. 0 으로 끄면 가리지 못한 글이 나갈 수 있습니다
REQUIRE_NAME_CHECK=1

# ── 반출 관문 ──
# 빠진 줄 명부에만 있는 이름이 스냅샷에 나올 때. warn 은 세기만 하고 block 은 멈춥니다 (명세 F-22 처리 2 는 멈추라고 합니다)
GATE_EXCLUDED_NAMES=warn

# ── 배치 실패 알림 (F-23 처리 5). 알림에는 자료 내용을 싣지 않습니다 ──
DISCORD_WEBHOOK=

# ── 관리 경로: UI-06, API-07. 질의 서버를 만들 때 씁니다 ──
ADMIN_TOKEN=

# ── 경로 ──
DATA_DIR=./data
SQLITE_PATH=./data/ragdb.sqlite
