# 이 파일을 .env로 복사해 값을 채웁니다. .env는 저장소에 올라가지 않습니다 (SR-10).
# 키를 지시문이나 코드에 직접 적지 않습니다 (SR-11).

# ── 입력: Supabase rag 스키마 (F-01, 명세 판 1.6) ──
# 정제 배치(darkchoco-data)가 만든 표준 문서를 받습니다. 노션 토큰은 두지 않습니다 (CR-09)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Claude — 답변 생성 (F-13) ──
# 전용 워크스페이스에서 발급하고, 콘솔에서 월 지출 한도를 걸고 자동 충전을 끕니다
ANTHROPIC_API_KEY=

# ── 재순위 — 후보 M개를 최종 K개로 (F-12 처리 8 · AD-12) ──
# 판 선택은 아직 미결(OI-25)입니다
COHERE_API_KEY=

# ── 관리 경로 — UI-06 · API-07 ──
# 되돌이 주소에서만 열고 터널 설정에 넣지 않습니다. 이 토큰으로 대조합니다 (5.3)
ADMIN_TOKEN=

# ── 하루 한도 — F-18 · SR-15. 값은 미결(OI-09), 아래는 초기값입니다 ──
DAILY_BUDGET_USD=1.5
PER_PERSON_DAILY_LIMIT=5

# ── 검색 — 값은 전부 미결(OI-02 · OI-14 · OI-15 · OI-21) ──
CANDIDATE_M=50
FINAL_K=5
EXPANSION_WEIGHT=0
RERANK_TIMEOUT_MS=

# ── 경로 ──
DATA_DIR=./data
SQLITE_PATH=./data/ragdb.sqlite
