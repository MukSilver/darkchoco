# 화면 설정. 값은 .env.local (개발) 이나 배포 설정에 둔다. 전부 공개 값이다 (화면 코드에 그대로 들어감). 비밀 열쇠를 여기 두지 않는다

# 질의 서버 주소. 개발 때는 비워 둔다 (화면 개발 서버가 /api 를 127.0.0.1:8787 로 넘김). 배포: https://rag-api.도메인
VITE_API_BASE=
# 스냅샷 자리. 기본 /data
VITE_DATA_BASE=
# 사람 확인(Cloudflare Turnstile) 사이트 열쇠. 서버에 TURNSTILE_SECRET 이 있을 때만 쓰인다
# 개발용 더미 값(늘 통과): 1x00000000000000000000AA  서버 쪽 짝: 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITEKEY=
# 화면 하단에 보일 팀 연락 메일. 비우면 안 보인다
VITE_CONTACT_EMAIL=
