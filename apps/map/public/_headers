# Cloudflare 정적 자산 배포가 읽는 응답 헤더 규칙이다.
# `npm run build` 가 public/ 을 out/ 에 그대로 옮기고, wrangler.jsonc 의
# assets.directory(out) 안에 있어야 적용된다. 옛 사이트(apps/site/_headers)와 같은 규칙이다.

/*
  # 색인 거부. robots.txt 와 meta 가 못 덮는 자바스크립트 · 자료 파일까지 덮는다.
  # 지도 자료(map.json)는 자바스크립트 묶음에 들어가 있어 이 헤더가 유일한 거부 표시다
  X-Robots-Tag: noindex, nofollow, noarchive

  # 이 지도는 밖으로 무엇을 보낼 일이 없다. connect-src 를 self 로 묶어 코드가
  # 무엇을 하든 다른 곳으로 못 부르게 한다. 반출 관문의 마지막 자물쇠다.
  # Next.js 가 화면 안에 인라인 스크립트(__next_f)를 넣고, React 가 style 속성을
  # 쓰므로 inline 은 열어 둔다. 정적 내보내기라 nonce 를 쓸 수 없다
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

  # 주소를 남에게 흘리지 않는다. 링크를 눌러 나가도 어디서 왔는지 안 넘어간다
  Referrer-Policy: no-referrer

  # 남의 페이지 안에 끼워 넣지 못하게 한다. frame-ancestors 와 겹치지만
  # 옛 브라우저는 이쪽만 본다
  X-Frame-Options: DENY

  # 확장자와 다른 것으로 읽히지 않게 한다
  X-Content-Type-Options: nosniff

  # 쓸 일이 없는 장치 권한을 닫는다
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
