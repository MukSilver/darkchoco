{
  "name": "darkchoco-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node tools/ensure_map.mjs",
    "dev": "next dev",
    "prebuild": "node tools/ensure_map.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node tools/ensure_map.mjs",
    "test": "npm run bake:check && python tools/bake_test.py && node --experimental-strip-types --test src/lib/*.test.mjs",
    "bake": "python tools/bake.py --out src/data/map.json",
    "bake:check": "python tools/bake.py --check-only --out src/data/map.json",
    "predeploy": "node tools/ensure_map.mjs --baked",
    "deploy": "npm run test && npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
