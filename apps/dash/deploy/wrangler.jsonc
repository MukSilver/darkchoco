{
  // 대시보드 배포. **산출물 사이트와 별도입니다** (2026-09-08, 최현서).
  //
  // 산출물 사이트(darkchoco-site)는 기자와 옆팀에게 보여 줄 자리이고 여기는 내부
  // 운영 화면입니다. 한 주소에 두면 자물쇠를 사이트 전체에 걸어야 하고 그러면
  // 산출물까지 같이 잠깁니다.
  //
  // **이 화면에는 피해 조직 실명과 미검토 줄이 그대로 들어 있습니다.**
  // 지도는 같은 데이터에서 「웹에 올림 = 예」 를 통과한 것만 이름을 내보냅니다.
  // 그러니 배포하기 전에 Cloudflare Access 를 반드시 겁니다.
  "name": "darkchoco-dash",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",

  "assets": {
    // 굽는 도구가 낸 것을 그대로 올립니다. build.py 가 data/dash.js 를 만듭니다.
    "directory": "../",
    "binding": "ASSETS",
    "not_found_handling": "404-page",

    // **이것이 없으면 자물쇠가 통째로 우회됩니다.** 기본값에서는 정적 자산이
    // Worker 보다 먼저 서빙되어 코드가 아예 안 돕니다. 2026-09-08 에 그대로
    // 배포했다가 비밀번호를 안 묻고 화면이 열리는 것을 실물로 확인했습니다.
    // Worker 가 먼저 받아야 통과했나() 를 지나 자산으로 갑니다.
    "run_worker_first": true
  },

  // 비밀값은 여기 안 적습니다. 둘 다 `wrangler secret put` 으로 넣습니다.
  //
  //   NOTION_TOKEN    노션 통합 토큰. O / X 를 쓸 때만 씁니다
  //   DASH_PASSWORD   팀이 함께 쓰는 비밀번호. **없으면 아무도 못 들어옵니다**
  //
  // Cloudflare Access 는 등록된 도메인에만 걸립니다. workers.dev 주소에는 못 걸어
  // 비밀번호로 잠급니다. 도메인이 생기면 Access 로 옮기면 되고, Worker 가 그때
  // 붙는 헤더도 같이 봅니다.
}
