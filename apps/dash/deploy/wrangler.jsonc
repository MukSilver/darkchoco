{
  // 대시보드 배포. **산출물 사이트와 별도입니다** (2026-09-08, 최현서).
  //
  // 산출물 사이트(darkchoco-site)는 기자와 옆팀에게 보여 줄 자리이고 여기는 내부
  // 운영 화면입니다. 한 주소에 두면 자물쇠를 사이트 전체에 걸어야 하고 그러면
  // 산출물까지 같이 잠깁니다.
  //
  // **이 화면에는 피해 조직 실명과 미검토 줄이 그대로 들어 있습니다.**
  // 지도는 같은 데이터에서 「웹에 올림 = 예」 를 통과한 것만 이름을 내보냅니다.
  // 그러니 배포하기 전에 Cloudflare Access 를 반드시 겁니다.
  "name": "darkchoco-dash",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",

  "assets": {
    // 굽는 도구가 낸 것을 그대로 올립니다. build.py 가 data/dash.js 를 만듭니다.
    "directory": "../",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // 비밀값은 여기 안 적습니다. `wrangler secret put NOTION_TOKEN` 으로 넣습니다.
  "vars": {
    // Access 를 붙이기 전 시험할 때만 "yes". 그동안은 주소를 아는 사람이 다 봅니다.
    "ACCESS_OPTIONAL": "no"
  },

  // 배포에 딸려 가면 안 되는 것.
  "assets_ignore": [
    "*.py",
    "README.md",
    "deploy/**"
  ]
}
