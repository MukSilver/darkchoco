# 비밀 — 절대 커밋하지 않습니다
.env
*.env
!.env.example
*token*
!*token*.py
!*token*.md

# 수집 결과·상태 — 저장소는 코드만 관리합니다
out/
output/
sessions/
snapshots/
web/data/*.json
*.sqlite3
probe*.json

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# 편집기·OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 수집한 것은 저장소에 넣지 않습니다. 본문에 개인정보가 들어 있습니다.
*.db
*.db-journal
*.db-wal
data/
hub/data/

# 개인정보가 든 변환 재료와 결과. convert_tt_to_xlsx.py 가 이 둘을 다룹니다
apps/tg-korea-alert/tt.txt
apps/tg-korea-alert/tt.xlsx

# 텔레그램 실계정 세션. 이것만 있으면 남이 그 계정으로 읽습니다.
# hub/events/telegram/*.py 셋이 BASE_DIR/telegram_session 을 보므로
# 세션 파일이 저장소 안에 놓입니다. sessions/ 폴더 규칙으로는 안 막힙니다
*.session
*.session-journal

# **볼 채널 목록은 커밋하지 않습니다.** 무엇을 보고 있는지가 드러납니다.
# monitor.py:12 가 이 이름으로 읽고, 통합 전 저장소가 막고 있던 것입니다
telegram_channels.txt
*_channels.txt
