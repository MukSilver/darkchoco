# 비밀 — 절대 커밋하지 않습니다
.env
*.env
!.env.example
*token*
!*token*.py
!*token*.md

# 수집 결과·상태 — 저장소는 코드만 관리합니다
out/
output/
sessions/
snapshots/
web/data/*.json
*.sqlite3
probe*.json

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# 편집기·OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 수집한 것은 저장소에 넣지 않습니다. 본문에 개인정보가 들어 있습니다.
*.db
*.db-journal
*.db-wal
data/
hub/data/

# 개인정보가 든 변환 재료와 결과. convert_tt_to_xlsx.py 가 이 둘을 다룹니다
apps/tg-korea-alert/tt.txt
apps/tg-korea-alert/tt.xlsx

# 텔레그램 실계정 세션. 이것만 있으면 남이 그 계정으로 읽습니다.
# hub/events/telegram/*.py 셋이 BASE_DIR/telegram_session 을 보므로
# 세션 파일이 저장소 안에 놓입니다. sessions/ 폴더 규칙으로는 안 막힙니다
*.session
*.session-journal

# **볼 채널 목록은 커밋하지 않습니다.** 무엇을 보고 있는지가 드러납니다.
# monitor.py:12 가 이 이름으로 읽고, 통합 전 저장소가 막고 있던 것입니다
telegram_channels.txt
*_channels.txt

# wrangler 가 만드는 로컬 캐시. **계정 ID 가 들어 있습니다.**
# 배포에서는 apps/dash/.assetsignore 가 따로 막지만, 여기를 안 막으면
# `git add -A` 한 번에 레포로 들어갑니다 (2026-09-08 에 실제로 안 막혀 있었습니다)
.wrangler/

# 대시보드가 구워 내는 데이터. **피해 조직 실명이 들어 있습니다.**
# 위 `data/` 규칙에 우연히 걸려 지금도 안 들어가지만, 그 규칙을 `/data/` 로
# 좁히는 순간 실명이 커밋됩니다. 우연에 기대지 않게 여기에 따로 적습니다
apps/dash/data/
